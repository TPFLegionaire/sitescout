# Named pilot role allowlists. Separate addresses with commas, semicolons or spaces.
QUALITY_ADMIN_EMAILS=
QUALITY_VALIDATOR_EMAILS=
QUALITY_FINDING_OWNER_EMAILS=
QUALITY_REPORTER_EMAILS=
QUALITY_MANAGEMENT_VIEWER_EMAILS=

# Production must use cloudflare-access. local-test is reserved for the
# disposable development harness and is rejected by production builds.
QUALITY_AUTH_MODE=cloudflare-access
QUALITY_CF_ACCESS_TEAM_DOMAIN=
QUALITY_CF_ACCESS_AUD=

# Optional public, read-only management preview. Anonymous visitors can view
# the audit dashboard but cannot submit, review, assign, edit or promote data.
QUALITY_PUBLIC_DEMO=false

# Legacy single administrator setting; retained for backwards compatibility.
QUALITY_OWNER_EMAIL=

# Optional text-only OpenAI triage. Keep disabled until privacy and data-processing approval.
QUALITY_AI_ASSIST_ENABLED=false
QUALITY_AI_MODEL=
OPENAI_API_KEY=

# Direct SEO snapshot pilot (revised plan v2, Phase 1). Reference DataForSEO
# integration. Keep disabled until commercial terms and spend caps are approved.
# Read-only SEO intelligence only; it never authorises active website testing.
QUALITY_SEO_ENABLED=false
QUALITY_SEO_PER_OPERATION_CAP_USD=1
QUALITY_SEO_MONTHLY_CAP_USD=25
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional. Use https://sandbox.dataforseo.com for non-billable testing.
DATAFORSEO_BASE_URL=
